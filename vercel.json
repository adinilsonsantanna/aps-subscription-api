{
    "version": 2,
    "builds": [
        {
            "src": "api/**/*.ts",
            "use": "@vercel/node"
        }
    ],
    "crons": [{ "path": "/api/cron/retry-billing", "schedule": "*/10 * * * *" }],
    "routes": [
        {
            "src": "/api/webhooks/stripe",
            "dest": "/api/webhooks/stripe.ts"
        },
        {
            "src": "/api/checkout/setup",
            "dest": "/api/checkout/setup.ts"
        },
        {
            "src": "/checkout",
            "dest": "/api/checkout.ts"
        },
        {
            "src": "/(.*)",
            "dest": "/api/index.ts"
        }
    ]
}
