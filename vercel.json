{
    "version": 2,
    "builds": [
        {
            "src": "api/**/*.ts",
            "use": "@vercel/node"
        }
    ],
    "crons": [
        { "path": "/api/cron/retry-billing", "schedule": "0 9 * * *" },
        { "path": "/api/cron/subscription-gifts", "schedule": "0 * * * *" }
    ],
    "routes": [
        {
            "src": "/api/webhooks/stripe",
            "dest": "/api/webhooks/stripe.ts"
        },
        {
            "src": "/api/checkout/setup",
            "dest": "/api/checkout/setup.ts"
        },
        {
            "src": "/checkout",
            "dest": "/api/checkout.ts"
        },
        {
            "src": "/(.*)",
            "dest": "/api/index.ts"
        }
    ]
}
