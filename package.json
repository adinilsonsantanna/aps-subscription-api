{
  "name": "aps-subscription-api",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "typecheck": "prisma generate && tsc --noEmit",
    "build": "prisma generate && tsc",
    "migrate:deploy": "prisma migrate deploy",
    "postinstall": "prisma generate",
    "start": "node dist/server.js",
    "test": "npm run build && node --test dist/src/**/__tests__/*.test.js",
    "test:integration": "npm run build && node --test dist/src/retry/__tests__/retry-engine.service.test.js dist/src/stripe/__tests__/subscription-order-prisma.test.js dist/src/shopify/events/__tests__/shopify-notification-integration.test.js",
    "test:contract": "npm run build && node --test dist/src/shopify/events/__tests__/shopify-event.service.test.js dist/src/controllers/__tests__/retry-cron.controller.test.js",
    "test:full-cycle": "npm test",
    "test:live:dry-run": "node scripts/live-subscription-smoke.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adinilsonsantanna/aps-subscription-api.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/adinilsonsantanna/aps-subscription-api/issues"
  },
  "homepage": "https://github.com/adinilsonsantanna/aps-subscription-api#readme",
  "dependencies": {
    "@vercel/functions": "^2.2.12",
    "@prisma/client": "^6.19.3",
    "@shopify/shopify-api": "^13.1.0",
    "@vercel/node": "^5.9.5",
    "dotenv": "^16.6.1",
    "express": "^5.2.1",
    "prisma": "^6.19.3",
    "resend": "^6.21.0",
    "stripe": "^17.7.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.6.3"
  }
}
