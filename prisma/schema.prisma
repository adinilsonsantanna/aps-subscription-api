generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Shop {
  id                         String                       @id @default(cuid())
  shopifyShopId              String?                      @unique
  name                       String
  domain                     String                       @unique
  accessToken                String                       @db.Text
  scopes                     String                       @db.Text
  gateway                    String                       @default("stripe")
  isActive                   Boolean                      @default(true)
  subscriptions              Subscription[]
  webhooks                   WebhookEvent[]
  billingAttempts            SubscriptionBillingAttempt[]
  retrySettings              BillingRetrySettings?
  retryCycles                BillingRetryCycle[]
  retryJobs                  BillingRetryJob[]
  notifications              NotificationOutbox[]
  notificationEvents         NotificationEvent[]
  notificationSettings       NotificationSettings?
  sendingDomains             SendingDomain[]
  notificationDeliveryEvents NotificationDeliveryEvent[]
  createdAt                  DateTime                     @default(now())
  updatedAt                  DateTime                     @updatedAt
}

model Subscription {
  id                        String                        @id @default(cuid())
  shopId                    String
  shop                      Shop                          @relation(fields: [shopId], references: [id], onDelete: Cascade)
  orders                    SubscriptionOrder[]
  contractLines             SubscriptionLine[]
  shopifyContractId         String?
  shopifyRevisionId         String?
  shopifyOriginOrderId      String?
  shopifyCustomerId         String?
  shopifyCustomerEmail      String?
  shopifyProductId          String?
  shopifyVariantId          String?
  gateway                   String?
  externalId                String?
  stripeCustomerId          String?
  stripePaymentMethodId     String?
  status                    String?
  currencyCode              String?
  billingInterval           String?
  billingIntervalCount      Int?
  deliveryInterval          String?
  deliveryIntervalCount     Int?
  interval                  Int?
  intervalType              String?
  nextBillingAt             DateTime?
  lastPaymentStatus         String?
  lastGatewayStatusEventAt  DateTime?
  lastGatewayPaymentEventAt DateTime?
  billingAttempts           SubscriptionBillingAttempt[]
  lifecycleActions          SubscriptionLifecycleAction[]
  statusHistory             SubscriptionStatusHistory[]
  retryCycles               BillingRetryCycle[]
  retryJobs                 BillingRetryJob[]
  createdAt                 DateTime                      @default(now())
  updatedAt                 DateTime                      @updatedAt

  @@unique([shopId, shopifyContractId])
  @@index([shopifyContractId])
}

enum RetryKind {
  INVENTORY
  PAYMENT
}

enum RetryJobStatus {
  PENDING
  CLAIMED
  SUCCEEDED
  FAILED
  EXHAUSTED
  SKIPPED
  UNCERTAIN
}

enum RetryFailureAction {
  PAUSE_AND_NOTIFY
  CANCEL_AND_NOTIFY
  SKIP_AND_NOTIFY
}

enum TeamNotificationFrequency {
  IMMEDIATELY
  DAILY_SUMMARY
  WEEKLY_SUMMARY
  NEVER
}

model BillingRetrySettings {
  shopId                    String                    @id
  shop                      Shop                      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  paymentRetryAttempts      Int                       @default(3)
  paymentRetryDays          Int                       @default(2)
  paymentFailureAction      RetryFailureAction        @default(PAUSE_AND_NOTIFY)
  inventoryRetryAttempts    Int                       @default(5)
  inventoryRetryDays        Int                       @default(1)
  inventoryFailureAction    RetryFailureAction        @default(SKIP_AND_NOTIFY)
  teamNotificationFrequency TeamNotificationFrequency @default(WEEKLY_SUMMARY)
  createdAt                 DateTime                  @default(now())
  updatedAt                 DateTime                  @updatedAt
}

model BillingRetryCycle {
  id                        String               @id @default(cuid())
  shopId                    String
  shop                      Shop                 @relation(fields: [shopId], references: [id], onDelete: Cascade)
  subscriptionId            String
  subscription              Subscription         @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  billingCycleAt            DateTime
  status                    String               @default("pending")
  finalAction               RetryFailureAction?
  finalActionAt             DateTime?
  finalActionStatus         String               @default("none")
  finalActionClaimedAt      DateTime?
  finalActionLeaseExpiresAt DateTime?
  finalActionError          String?
  nextBillingAdvanced       Boolean              @default(false)
  createdAt                 DateTime             @default(now())
  updatedAt                 DateTime             @updatedAt
  jobs                      BillingRetryJob[]
  notifications             NotificationOutbox[]

  @@unique([subscriptionId, billingCycleAt])
  @@index([shopId, status])
  @@index([finalActionStatus, finalActionLeaseExpiresAt])
}

model BillingRetryJob {
  id                       String              @id @default(cuid())
  shopId                   String
  shop                     Shop                @relation(fields: [shopId], references: [id], onDelete: Cascade)
  subscriptionId           String
  subscription             Subscription        @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  cycleId                  String
  cycle                    BillingRetryCycle   @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  kind                     RetryKind
  attemptNumber            Int
  maxRetries               Int
  status                   RetryJobStatus      @default(PENDING)
  scheduledAt              DateTime
  claimedAt                DateTime?
  leaseExpiresAt           DateTime?
  completedAt              DateTime?
  idempotencyKey           String              @unique
  errorCode                String?
  errorMessage             String?
  inventoryResult          Json?
  externalAttemptId        String?
  externalOrderId          String?
  reconciliationCount      Int                 @default(0)
  maxReconciliations       Int                 @default(12)
  firstUncertainAt         DateTime?
  lastReconciledAt         DateTime?
  reconciliationDeadlineAt DateTime?
  finalAction              RetryFailureAction?
  createdAt                DateTime            @default(now())
  updatedAt                DateTime            @updatedAt

  @@unique([cycleId, kind, attemptNumber])
  @@index([status, scheduledAt])
  @@index([status, leaseExpiresAt])
  @@index([subscriptionId, kind, status])
}

model NotificationOutbox {
  id                  String                    @id @default(cuid())
  shopId              String
  shop                Shop                      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  cycleId             String?
  cycle               BillingRetryCycle?        @relation(fields: [cycleId], references: [id], onDelete: SetNull)
  idempotencyKey      String                    @unique
  frequency           TeamNotificationFrequency
  eventType           String
  payload             Json
  status              String                    @default("pending")
  availableAt         DateTime
  sentAt              DateTime?
  errorMessage        String?
  recipientType       String                    @default("team")
  recipientEmail      String?
  subject             String?
  htmlBody            String?                   @db.Text
  textBody            String?                   @db.Text
  attemptCount        Int                       @default(0)
  maxAttempts         Int                       @default(5)
  claimedAt           DateTime?
  leaseExpiresAt      DateTime?
  providerMessageId   String?                   @unique
  lastAttemptAt       DateTime?
  deliveredAt         DateTime?
  externalSucceededAt DateTime?
  deliveryUncertainAt DateTime?
  deliveryDeadlineAt  DateTime?
  includedEventIds    String[]                  @default([])
  includedEvents      NotificationEvent[]
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt

  @@index([status, availableAt])
  @@index([status, leaseExpiresAt])
  @@index([shopId, frequency, availableAt])
}

model NotificationEvent {
  id                 String                    @id @default(cuid())
  shopId             String
  shop               Shop                      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  idempotencyKey     String                    @unique
  eventType          String
  payload            Json
  recipientEmail     String?
  frequency          TeamNotificationFrequency
  windowKey          String?
  windowEndAt        DateTime?
  includedInOutboxId String?
  includedInOutbox   NotificationOutbox?       @relation(fields: [includedInOutboxId], references: [id], onDelete: SetNull)
  createdAt          DateTime                  @default(now())

  @@index([shopId, frequency, windowKey])
  @@index([includedInOutboxId, windowEndAt])
}

model NotificationSettings {
  shopId                       String                    @id
  shop                         Shop                      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  fromName                     String?
  fromEmail                    String?
  replyTo                      String?
  activeFromName               String?
  activeFromEmail              String?
  activeReplyTo                String?
  teamEmails                   String[]
  teamFrequency                TeamNotificationFrequency @default(WEEKLY_SUMMARY)
  customerNotificationsEnabled Boolean                   @default(false)
  paymentFailedEnabled         Boolean                   @default(true)
  retryScheduledEnabled        Boolean                   @default(true)
  inventoryFailedEnabled       Boolean                   @default(true)
  inventoryRetryEnabled        Boolean                   @default(true)
  pausedEnabled                Boolean                   @default(true)
  cancelledEnabled             Boolean                   @default(true)
  renewalSucceededEnabled      Boolean                   @default(true)
  lastTestAt                   DateTime?
  activeSendingDomainId        String?                   @unique
  activeSendingDomain          SendingDomain?            @relation("ActiveSendingDomain", fields: [activeSendingDomainId], references: [id], onDelete: SetNull)
  createdAt                    DateTime                  @default(now())
  updatedAt                    DateTime                  @updatedAt
}

model SendingDomain {
  id                     String                        @id @default(cuid())
  shopId                 String
  shop                   Shop                          @relation(fields: [shopId], references: [id], onDelete: Cascade)
  domain                 String                        @unique
  providerDomainId       String?                       @unique
  status                 String                        @default("not_configured")
  sendingVerified        Boolean                       @default(false)
  encryptedApiKey        String?                       @db.Text
  apiKeyId               String?
  pendingEncryptedApiKey String?                       @db.Text
  pendingApiKeyId        String?
  previousApiKeyId       String?
  credentialStatus       String                        @default("active")
  credentialVersion      Int                           @default(1)
  lastCheckedAt          DateTime?
  disabledAt             DateTime?
  records                SendingDomainDnsRecord[]
  activeForSettings      NotificationSettings?         @relation("ActiveSendingDomain")
  createdAt              DateTime                      @default(now())
  updatedAt              DateTime                      @updatedAt
  cleanupJobs            SendingCredentialCleanupJob[]

  @@unique([shopId, domain])
  @@index([shopId, status])
}

model SendingCredentialCleanupJob {
  id               String        @id @default(cuid())
  sendingDomainId  String
  sendingDomain    SendingDomain @relation(fields: [sendingDomainId], references: [id], onDelete: Cascade)
  providerApiKeyId String
  reason           String
  status           String        @default("pending")
  attemptCount     Int           @default(0)
  maxAttempts      Int           @default(12)
  availableAt      DateTime      @default(now())
  claimedAt        DateTime?
  leaseExpiresAt   DateTime?
  completedAt      DateTime?
  lastError        String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@unique([sendingDomainId, providerApiKeyId, reason])
  @@index([status, availableAt])
  @@index([status, leaseExpiresAt])
}

model SendingDomainDnsRecord {
  id              String        @id @default(cuid())
  sendingDomainId String
  sendingDomain   SendingDomain @relation(fields: [sendingDomainId], references: [id], onDelete: Cascade)
  purpose         String
  type            String
  name            String
  value           String        @db.Text
  priority        Int?
  ttl             String?
  status          String
  position        Int
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([sendingDomainId, position])
}

model NotificationDeliveryEvent {
  id                String    @id @default(cuid())
  shopId            String?
  shop              Shop?     @relation(fields: [shopId], references: [id], onDelete: SetNull)
  providerEventId   String    @unique
  providerMessageId String?
  providerDomainId  String?
  type              String
  payload           Json
  occurredAt        DateTime?
  processedAt       DateTime  @default(now())
  createdAt         DateTime  @default(now())

  @@index([providerMessageId])
  @@index([providerDomainId])
  @@index([shopId, createdAt])
}

model SubscriptionLifecycleAction {
  id             String                      @id @default(cuid())
  subscriptionId String
  subscription   Subscription                @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  idempotencyKey String
  action         String
  gateway        String
  actor          String
  status         String
  externalStatus String?
  errorCode      String?
  errorMessage   String?
  httpStatus     Int?
  createdAt      DateTime                    @default(now())
  completedAt    DateTime?
  updatedAt      DateTime                    @updatedAt
  history        SubscriptionStatusHistory[]

  @@unique([subscriptionId, idempotencyKey])
  @@index([subscriptionId])
  @@index([status])
}

model SubscriptionStatusHistory {
  id                    String                       @id @default(cuid())
  subscriptionId        String
  subscription          Subscription                 @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  previousStatus        String?
  newStatus             String
  previousPaymentStatus String?
  newPaymentStatus      String?
  source                String
  sourceEventId         String?
  lifecycleActionId     String?
  lifecycleAction       SubscriptionLifecycleAction? @relation(fields: [lifecycleActionId], references: [id], onDelete: SetNull)
  actor                 String?
  reason                String?
  createdAt             DateTime                     @default(now())

  @@unique([source, sourceEventId])
  @@index([subscriptionId, createdAt])
  @@index([lifecycleActionId])
}

model SubscriptionOrder {
  id                    String       @id @default(cuid())
  subscriptionId        String
  subscription          Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  shopifyOrderId        String?
  shopifyOrderKey       String?      @unique
  gatewayOrderId        String?
  amount                Decimal      @db.Decimal(10, 2)
  currencyCode          String?
  status                String
  shopifyOrderClaimedAt DateTime?
  processedAt           DateTime?
  createdAt             DateTime     @default(now())

  @@unique([subscriptionId, gatewayOrderId])
}

model WebhookEvent {
  id             String    @id @default(cuid())
  shopId         String? // <-- ALTERADO: tornou-se opcional
  shop           Shop?     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  source         String
  eventId        String    @unique
  shopifyEventId String?
  topic          String
  payload        Json
  processed      Boolean   @default(false)
  receivedAt     DateTime  @default(now())
  processedAt    DateTime?
  errorMessage   String?
  createdAt      DateTime  @default(now())

  @@index([shopifyEventId])
}

model SubscriptionLine {
  id                        String       @id @default(cuid())
  subscriptionId            String
  subscription              Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  shopifySubscriptionLineId String
  shopifyProductId          String?
  shopifyVariantId          String?
  shopifySellingPlanId      String?
  quantity                  Int
  currentPrice              Decimal?     @db.Decimal(10, 2)
  currencyCode              String?
  isActive                  Boolean      @default(true)
  createdAt                 DateTime     @default(now())
  updatedAt                 DateTime     @updatedAt

  @@unique([subscriptionId, shopifySubscriptionLineId])
  @@index([shopifyProductId])
  @@index([shopifyVariantId])
  @@index([shopifySellingPlanId])
}

model SubscriptionBillingAttempt {
  id                      String       @id @default(cuid())
  shopId                  String
  shop                    Shop         @relation(fields: [shopId], references: [id], onDelete: Cascade)
  subscriptionId          String
  subscription            Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  shopifyContractId       String
  shopifyBillingAttemptId String?
  idempotencyKey          String?
  webhookEventId          String?      @unique
  status                  String
  errorCode               String?
  errorMessage            String?
  shopifyOrderId          String?
  nextActionUrl           String?
  attemptedAt             DateTime?
  createdAt               DateTime     @default(now())
  updatedAt               DateTime     @updatedAt

  @@unique([shopId, shopifyBillingAttemptId])
  @@unique([shopId, idempotencyKey])
  @@index([shopId, shopifyContractId])
  @@index([subscriptionId, status])
}
