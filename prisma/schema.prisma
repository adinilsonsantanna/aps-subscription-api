generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Shop {
  id              String                       @id @default(cuid())
  shopifyShopId   String?                      @unique
  name            String
  domain          String                       @unique
  accessToken     String                       @db.Text
  scopes          String                       @db.Text
  gateway         String                       @default("stripe")
  isActive        Boolean                      @default(true)
  subscriptions   Subscription[]
  webhooks        WebhookEvent[]
  billingAttempts SubscriptionBillingAttempt[]
  createdAt       DateTime                     @default(now())
  updatedAt       DateTime                     @updatedAt
}

model Subscription {
  id                    String                       @id @default(cuid())
  shopId                String
  shop                  Shop                         @relation(fields: [shopId], references: [id], onDelete: Cascade)
  orders                SubscriptionOrder[]
  shopifyContractId     String?
  shopifyOriginOrderId  String?
  shopifyCustomerId     String?
  shopifyProductId      String?
  shopifyVariantId      String?
  gateway               String?
  externalId            String?
  stripeCustomerId      String?
  stripePaymentMethodId String?
  status                String?
  currencyCode          String?
  billingInterval       String?
  billingIntervalCount  Int?
  deliveryInterval      String?
  deliveryIntervalCount Int?
  interval              Int?
  intervalType          String?
  nextBillingAt         DateTime?
  lastPaymentStatus     String?
  billingAttempts       SubscriptionBillingAttempt[]
  createdAt             DateTime                     @default(now())
  updatedAt             DateTime                     @updatedAt

  @@unique([shopId, shopifyContractId])
  @@index([shopifyContractId])
}

model SubscriptionOrder {
  id             String       @id @default(cuid())
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  shopifyOrderId String?
  shopifyOrderKey String?      @unique
  gatewayOrderId String?
  amount         Decimal      @db.Decimal(10, 2)
  status         String
  processedAt    DateTime?
  createdAt      DateTime     @default(now())
}

model WebhookEvent {
  id           String    @id @default(cuid())
  shopId       String? // <-- ALTERADO: tornou-se opcional
  shop         Shop?     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  source       String
  eventId      String    @unique
  topic        String
  payload      Json
  processed    Boolean   @default(false)
  receivedAt   DateTime  @default(now())
  processedAt  DateTime?
  errorMessage String?
  createdAt    DateTime  @default(now())
}

model SubscriptionBillingAttempt {
  id                      String       @id @default(cuid())
  shopId                  String
  shop                    Shop         @relation(fields: [shopId], references: [id], onDelete: Cascade)
  subscriptionId          String
  subscription            Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  shopifyContractId       String
  shopifyBillingAttemptId String?
  idempotencyKey          String?
  webhookEventId          String?      @unique
  status                  String
  errorCode               String?
  errorMessage            String?
  shopifyOrderId          String?
  nextActionUrl           String?
  attemptedAt             DateTime?
  createdAt               DateTime     @default(now())
  updatedAt               DateTime     @updatedAt

  @@unique([shopId, shopifyBillingAttemptId])
  @@unique([shopId, idempotencyKey])
  @@index([shopId, shopifyContractId])
  @@index([subscriptionId, status])
}
