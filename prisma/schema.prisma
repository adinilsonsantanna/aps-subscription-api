generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Shop {
  id              String                       @id @default(cuid())
  shopifyShopId   String?                      @unique
  name            String
  domain          String                       @unique
  accessToken     String                       @db.Text
  scopes          String                       @db.Text
  gateway         String                       @default("stripe")
  isActive        Boolean                      @default(true)
  subscriptions   Subscription[]
  webhooks        WebhookEvent[]
  billingAttempts SubscriptionBillingAttempt[]
  retrySettings   BillingRetrySettings?
  retryCycles     BillingRetryCycle[]
  retryJobs       BillingRetryJob[]
  notifications   NotificationOutbox[]
  createdAt       DateTime                     @default(now())
  updatedAt       DateTime                     @updatedAt
}

model Subscription {
  id                        String                        @id @default(cuid())
  shopId                    String
  shop                      Shop                          @relation(fields: [shopId], references: [id], onDelete: Cascade)
  orders                    SubscriptionOrder[]
  contractLines             SubscriptionLine[]
  shopifyContractId         String?
  shopifyRevisionId         String?
  shopifyOriginOrderId      String?
  shopifyCustomerId         String?
  shopifyProductId          String?
  shopifyVariantId          String?
  gateway                   String?
  externalId                String?
  stripeCustomerId          String?
  stripePaymentMethodId     String?
  status                    String?
  currencyCode              String?
  billingInterval           String?
  billingIntervalCount      Int?
  deliveryInterval          String?
  deliveryIntervalCount     Int?
  interval                  Int?
  intervalType              String?
  nextBillingAt             DateTime?
  lastPaymentStatus         String?
  lastGatewayStatusEventAt  DateTime?
  lastGatewayPaymentEventAt DateTime?
  billingAttempts           SubscriptionBillingAttempt[]
  lifecycleActions          SubscriptionLifecycleAction[]
  statusHistory             SubscriptionStatusHistory[]
  retryCycles               BillingRetryCycle[]
  retryJobs                 BillingRetryJob[]
  createdAt                 DateTime                      @default(now())
  updatedAt                 DateTime                      @updatedAt

  @@unique([shopId, shopifyContractId])
  @@index([shopifyContractId])
}

enum RetryKind {
  INVENTORY
  PAYMENT
}

enum RetryJobStatus {
  PENDING
  CLAIMED
  SUCCEEDED
  FAILED
  EXHAUSTED
  SKIPPED
  UNCERTAIN
}

enum RetryFailureAction {
  PAUSE_AND_NOTIFY
  CANCEL_AND_NOTIFY
  SKIP_AND_NOTIFY
}

enum TeamNotificationFrequency {
  IMMEDIATELY
  DAILY_SUMMARY
  WEEKLY_SUMMARY
  NEVER
}

model BillingRetrySettings {
  shopId                    String                    @id
  shop                      Shop                      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  paymentRetryAttempts      Int                       @default(3)
  paymentRetryDays          Int                       @default(2)
  paymentFailureAction      RetryFailureAction        @default(PAUSE_AND_NOTIFY)
  inventoryRetryAttempts    Int                       @default(5)
  inventoryRetryDays        Int                       @default(1)
  inventoryFailureAction    RetryFailureAction        @default(SKIP_AND_NOTIFY)
  teamNotificationFrequency TeamNotificationFrequency @default(WEEKLY_SUMMARY)
  createdAt                 DateTime                  @default(now())
  updatedAt                 DateTime                  @updatedAt
}

model BillingRetryCycle {
  id                  String               @id @default(cuid())
  shopId              String
  shop                Shop                 @relation(fields: [shopId], references: [id], onDelete: Cascade)
  subscriptionId      String
  subscription        Subscription         @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  billingCycleAt      DateTime
  status              String               @default("pending")
  finalAction         RetryFailureAction?
  finalActionAt       DateTime?
  nextBillingAdvanced Boolean              @default(false)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  jobs                BillingRetryJob[]
  notifications       NotificationOutbox[]

  @@unique([subscriptionId, billingCycleAt])
  @@index([shopId, status])
}

model BillingRetryJob {
  id                String              @id @default(cuid())
  shopId            String
  shop              Shop                @relation(fields: [shopId], references: [id], onDelete: Cascade)
  subscriptionId    String
  subscription      Subscription        @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  cycleId           String
  cycle             BillingRetryCycle   @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  kind              RetryKind
  attemptNumber     Int
  maxRetries        Int
  status            RetryJobStatus      @default(PENDING)
  scheduledAt       DateTime
  claimedAt         DateTime?
  leaseExpiresAt    DateTime?
  completedAt       DateTime?
  idempotencyKey    String              @unique
  errorCode         String?
  errorMessage      String?
  inventoryResult   Json?
  externalAttemptId String?
  finalAction       RetryFailureAction?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@unique([cycleId, kind, attemptNumber])
  @@index([status, scheduledAt])
  @@index([status, leaseExpiresAt])
  @@index([subscriptionId, kind, status])
}

model NotificationOutbox {
  id             String                    @id @default(cuid())
  shopId         String
  shop           Shop                      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  cycleId        String
  cycle          BillingRetryCycle         @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  idempotencyKey String                    @unique
  frequency      TeamNotificationFrequency
  eventType      String
  payload        Json
  status         String                    @default("pending")
  availableAt    DateTime
  sentAt         DateTime?
  errorMessage   String?
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt

  @@index([status, availableAt])
  @@index([shopId, frequency, availableAt])
}

model SubscriptionLifecycleAction {
  id             String                      @id @default(cuid())
  subscriptionId String
  subscription   Subscription                @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  idempotencyKey String
  action         String
  gateway        String
  actor          String
  status         String
  externalStatus String?
  errorCode      String?
  errorMessage   String?
  httpStatus     Int?
  createdAt      DateTime                    @default(now())
  completedAt    DateTime?
  updatedAt      DateTime                    @updatedAt
  history        SubscriptionStatusHistory[]

  @@unique([subscriptionId, idempotencyKey])
  @@index([subscriptionId])
  @@index([status])
}

model SubscriptionStatusHistory {
  id                    String                       @id @default(cuid())
  subscriptionId        String
  subscription          Subscription                 @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  previousStatus        String?
  newStatus             String
  previousPaymentStatus String?
  newPaymentStatus      String?
  source                String
  sourceEventId         String?
  lifecycleActionId     String?
  lifecycleAction       SubscriptionLifecycleAction? @relation(fields: [lifecycleActionId], references: [id], onDelete: SetNull)
  actor                 String?
  reason                String?
  createdAt             DateTime                     @default(now())

  @@unique([source, sourceEventId])
  @@index([subscriptionId, createdAt])
  @@index([lifecycleActionId])
}

model SubscriptionOrder {
  id                    String       @id @default(cuid())
  subscriptionId        String
  subscription          Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  shopifyOrderId        String?
  shopifyOrderKey       String?      @unique
  gatewayOrderId        String?
  amount                Decimal      @db.Decimal(10, 2)
  currencyCode          String?
  status                String
  shopifyOrderClaimedAt DateTime?
  processedAt           DateTime?
  createdAt             DateTime     @default(now())

  @@unique([subscriptionId, gatewayOrderId])
}

model WebhookEvent {
  id             String    @id @default(cuid())
  shopId         String? // <-- ALTERADO: tornou-se opcional
  shop           Shop?     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  source         String
  eventId        String    @unique
  shopifyEventId String?
  topic          String
  payload        Json
  processed      Boolean   @default(false)
  receivedAt     DateTime  @default(now())
  processedAt    DateTime?
  errorMessage   String?
  createdAt      DateTime  @default(now())

  @@index([shopifyEventId])
}

model SubscriptionLine {
  id                        String       @id @default(cuid())
  subscriptionId            String
  subscription              Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  shopifySubscriptionLineId String
  shopifyProductId          String?
  shopifyVariantId          String?
  shopifySellingPlanId      String?
  quantity                  Int
  currentPrice              Decimal?     @db.Decimal(10, 2)
  currencyCode              String?
  isActive                  Boolean      @default(true)
  createdAt                 DateTime     @default(now())
  updatedAt                 DateTime     @updatedAt

  @@unique([subscriptionId, shopifySubscriptionLineId])
  @@index([shopifyProductId])
  @@index([shopifyVariantId])
  @@index([shopifySellingPlanId])
}

model SubscriptionBillingAttempt {
  id                      String       @id @default(cuid())
  shopId                  String
  shop                    Shop         @relation(fields: [shopId], references: [id], onDelete: Cascade)
  subscriptionId          String
  subscription            Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  shopifyContractId       String
  shopifyBillingAttemptId String?
  idempotencyKey          String?
  webhookEventId          String?      @unique
  status                  String
  errorCode               String?
  errorMessage            String?
  shopifyOrderId          String?
  nextActionUrl           String?
  attemptedAt             DateTime?
  createdAt               DateTime     @default(now())
  updatedAt               DateTime     @updatedAt

  @@unique([shopId, shopifyBillingAttemptId])
  @@unique([shopId, idempotencyKey])
  @@index([shopId, shopifyContractId])
  @@index([subscriptionId, status])
}
